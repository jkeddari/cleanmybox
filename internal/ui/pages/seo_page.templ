package pages

import (
  "github.com/jkeddari/cleanmybox/internal/ui/blocks"
  "github.com/jkeddari/cleanmybox/internal/ui/layouts"
)

type SEOPageSection struct {
  Heading string
  Body    string
  Items   []string
}

type SEOPageLink struct {
  Href  string
  Label string
}

type SEOPageProps struct {
  Title       string
  Description string
  Path        string
  Eyebrow     string
  H1          string
  Intro       string
  Sections    []SEOPageSection
  Related     []SEOPageLink
}

templ SEOPage(loggedIn bool, email string, props SEOPageProps) {
  @layouts.Base(layouts.SEOProps{
    Title:       props.Title,
    Description: props.Description,
    Path:        props.Path,
    Robots:      "index, follow",
  }) {
    @blocks.Navbar(loggedIn, email)

    <main class="mx-auto w-full max-w-5xl space-y-14 px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
      <section class="space-y-6 rounded-3xl border border-border bg-card/60 p-6 shadow-sm sm:p-10">
        <div class="max-w-3xl space-y-4">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">{ props.Eyebrow }</p>
          <h1 class="break-words text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{ props.H1 }</h1>
          <p class="max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg">{ props.Intro }</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          if loggedIn {
            <a href="/#pricing" class="inline-flex items-center justify-center rounded-xl bg-primary px-5 py-3 text-center text-sm font-semibold text-primary-foreground hover:opacity-90">Choose a cleanup</a>
          } else {
            <a href="/login" class="inline-flex items-center justify-center rounded-xl bg-primary px-5 py-3 text-center text-sm font-semibold text-primary-foreground hover:opacity-90">Connect your mailbox</a>
          }
          <a href="/#pricing" class="inline-flex items-center justify-center rounded-xl border border-border px-5 py-3 text-center text-sm font-semibold hover:bg-muted">See pricing</a>
        </div>
      </section>

      <div class="space-y-14">
        for _, section := range props.Sections {
          <section class="space-y-4 border-t border-border pt-8">
            <h2 class="text-2xl font-bold leading-tight tracking-tight sm:text-3xl">{ section.Heading }</h2>
            <p class="max-w-4xl text-base leading-7 text-muted-foreground">{ section.Body }</p>
            if len(section.Items) > 0 {
              <ul class="grid gap-3 text-sm sm:grid-cols-2">
                for _, item := range section.Items {
                  <li class="rounded-2xl border border-border bg-card p-4 leading-6 text-card-foreground">{ item }</li>
                }
              </ul>
            }
          </section>
        }
      </div>

      <section class="space-y-4 border-t border-border pt-8">
        <h2 class="text-2xl font-bold leading-tight tracking-tight sm:text-3xl">Explore more inbox cleanup resources</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          for _, link := range props.Related {
            <a href={ link.Href } class="rounded-2xl border border-border bg-card p-4 text-sm font-medium leading-6 text-card-foreground hover:bg-muted">{ link.Label }</a>
          }
        </div>
      </section>
    </main>

    @blocks.Footer()
  }
}
