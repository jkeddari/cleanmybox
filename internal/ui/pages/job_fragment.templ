package pages

import "fmt"

templ JobStatus(view JobStatusView) {
  if view.Found && (view.Status == "done" || view.Status == "error") {
    <div id="job-status" class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      @jobStatusContent(view)
    </div>
  } else {
    <div id="job-status"
         hx-get={ "/ui/job-fragment?session_id=" + view.SessionID }
         hx-trigger="every 2s"
         hx-swap="outerHTML"
         class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      @jobStatusContent(view)
    </div>
  }
}

templ jobStatusContent(view JobStatusView) {
    if !view.Found {
      <h2 class="text-xl font-semibold">Cleanup in progress</h2>
      <p class="mt-1 text-sm text-muted-foreground">Payment confirmed. Waiting for worker start...</p>
      <div class="mt-4 h-2 overflow-hidden rounded-full bg-muted">
        <div class="h-full w-[8%] animate-pulse rounded-full bg-primary"></div>
      </div>
      <p class="mt-3 text-xs text-muted-foreground">Session: { view.SessionID }</p>
    } else {
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          if view.Status == "done" {
            <h2 class="text-xl font-semibold">Cleanup result</h2>
          } else if view.Status == "error" {
            <h2 class="text-xl font-semibold">Cleanup failed</h2>
          } else {
            <h2 class="text-xl font-semibold">Cleanup in progress</h2>
          }
          <p class="text-sm text-muted-foreground">Step: <span class="font-medium text-foreground">{ view.Step }</span></p>
        </div>
        <div class="flex items-center gap-2">
          if view.Status == "error" {
            <span class="rounded-full border border-destructive/40 bg-destructive/10 px-3 py-1 text-xs text-destructive">Failed</span>
          } else if view.Status == "done" {
            <span class="rounded-full border border-emerald-400/40 bg-emerald-500/10 px-3 py-1 text-xs text-emerald-600 dark:text-emerald-400">Completed</span>
          } else {
            <span class="rounded-full border border-primary/40 bg-primary/10 px-3 py-1 text-xs text-primary">In progress</span>
          }
          if view.DryRun {
            <span class="rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs text-amber-700">Dry-run</span>
          }
        </div>
      </div>

      <div class="mt-5 h-2 overflow-hidden rounded-full bg-muted">
        <div class="h-full rounded-full bg-primary transition-all duration-500" style={ "width: " + fmt.Sprintf("%d%%", view.ProgressPercent) }></div>
      </div>

      <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
        <span>Current: { view.CurrentEmail }</span>
        <span class="font-semibold text-foreground">{ view.ProcessedCount } / { view.TotalCount } emails processed</span>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Deleted</p><p class="text-xl font-semibold">{ view.Stats.Deleted }</p></div>
        <div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Moved To Spam</p><p class="text-xl font-semibold">{ view.Stats.Spam }</p></div>
        <div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Archived</p><p class="text-xl font-semibold">{ view.Stats.Archived }</p></div>
        <div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Kept</p><p class="text-xl font-semibold">{ view.Stats.Kept }</p></div>
        <div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Unsubscribe</p><p class="text-xl font-semibold">{ view.Stats.Unsubscribed }</p></div>
        <div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Newsletter</p><p class="text-xl font-semibold">{ view.Stats.Newsletters }</p></div>
        <div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Scan failed</p><p class="text-xl font-semibold">{ view.Stats.ScanFailed }</p></div>
        <div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Scan time</p><p class="text-xl font-semibold">{ view.ScanDuration }</p></div>
      </div>

      if view.Error != "" {
        <p class="mt-4 text-sm font-medium text-destructive">{ view.Error }</p>
      }
      if view.Status == "done" || view.Status == "error" {
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90">Run another cleanup</a>
          <a href="/#pricing" class="rounded-lg border border-border bg-background px-4 py-2 text-sm font-semibold hover:bg-muted">See plans</a>
        </div>
      }
    }
}
