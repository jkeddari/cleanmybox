package pages

import (
	"github.com/jkeddari/cleanmybox/internal/ui/blocks"
	"github.com/jkeddari/cleanmybox/internal/ui/components/icon"
	"github.com/jkeddari/cleanmybox/internal/ui/layouts"
)

templ History(loggedIn bool, email string, view HistoryView) {
	@layouts.Base(layouts.SEOProps{
		Title:       "History - CleanMyBox",
		Description: "See your latest cleanup runs, status, and mailbox stats.",
		Path:        "/history",
		Robots:      "noindex, nofollow",
	}) {
		@blocks.Navbar(loggedIn, email)

		<main class="mx-auto w-full max-w-6xl space-y-8 px-4 py-10 sm:px-6 lg:px-8">
			<section class="flex flex-wrap items-start justify-between gap-4">
				<div>
					<h1 class="text-3xl font-bold tracking-tight">Cleanup history</h1>
					<p class="mt-2 text-sm text-muted-foreground">Last 20 runs for <span class="font-medium text-foreground">{ view.Email }</span>.</p>
				</div>
				<a href="/#pricing" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:opacity-90">Run new cleanup</a>
			</section>

			<section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				<div class="rounded-2xl border border-border bg-card p-4"><p class="text-xs text-muted-foreground">Total runs</p><p class="mt-1 text-2xl font-bold">{ view.TotalRuns }</p></div>
				<div class="rounded-2xl border border-border bg-card p-4"><p class="text-xs text-muted-foreground">Success rate</p><p class="mt-1 text-2xl font-bold">{ view.SuccessRate }%</p></div>
				<div class="rounded-2xl border border-border bg-card p-4"><p class="text-xs text-muted-foreground">Total deleted</p><p class="mt-1 text-2xl font-bold">{ view.DeletedTotal }</p></div>
				<div class="rounded-2xl border border-border bg-card p-4"><p class="text-xs text-muted-foreground">Total archived</p><p class="mt-1 text-2xl font-bold">{ view.ArchivedTotal }</p></div>
			</section>

			if len(view.Runs) == 0 {
				<section class="rounded-2xl border border-border bg-card p-10 text-center">
					<div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-muted">
						@icon.Icon("pulse", "size-5 text-muted-foreground")
					</div>
					<h2 class="mt-4 text-lg font-semibold">No cleanup runs yet</h2>
					<p class="mt-2 text-sm text-muted-foreground">Complete your first run to see detailed history and stats.</p>
				</section>
			} else {
				<section class="space-y-3">
				for _, run := range view.Runs {
					<div class="rounded-2xl border border-border bg-card p-4">
						<div class="flex flex-wrap items-center justify-between gap-3">
							<div class="flex flex-wrap items-center gap-2">
								<span class="rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-medium">{ run.Plan }</span>
								if run.Status == "done" {
									<span class="rounded-full border border-emerald-400/40 bg-emerald-500/10 px-2.5 py-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">Completed</span>
								} else {
									<span class="rounded-full border border-destructive/40 bg-destructive/10 px-2.5 py-1 text-xs font-medium text-destructive">Failed</span>
								}
								if run.DryRun {
									<span class="rounded-full border border-amber-300 bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">Dry-run</span>
								}
							</div>
							<div class="text-right text-xs text-muted-foreground">
								<p>{ run.CreatedAt }</p>
								<p class="mt-0.5">{ run.Duration }</p>
							</div>
						</div>

						<div class="mt-4 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-5">
							<div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Deleted</p><p class="mt-1 font-semibold">{ run.Stats.Deleted }</p></div>
							<div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Archived</p><p class="mt-1 font-semibold">{ run.Stats.Archived }</p></div>
							<div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Spam</p><p class="mt-1 font-semibold">{ run.Stats.Spam }</p></div>
							<div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Kept</p><p class="mt-1 font-semibold">{ run.Stats.Kept }</p></div>
							<div class="rounded-lg bg-muted p-3"><p class="text-xs text-muted-foreground">Scanned</p><p class="mt-1 font-semibold">{ run.Stats.TotalScanned }</p></div>
						</div>

						if run.Error != "" {
							<p class="mt-3 rounded-lg border border-destructive/30 bg-destructive/5 p-3 text-xs text-destructive">{ run.Error }</p>
						}
					</div>
				}
				</section>
			}
		</main>

		@blocks.Footer()
	}
}
