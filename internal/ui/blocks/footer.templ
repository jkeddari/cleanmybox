package blocks

templ Footer() {
  <footer class="border-t border-border py-6 text-xs text-muted-foreground">
    <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-2 px-4 sm:px-6 lg:px-8">
      <span>CleanMyBox - Secure one-shot mailbox cleanup</span>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/guides" class="hover:text-foreground">Guides</a>
        <span>•</span>
        <a href="/legal/privacy" class="hover:text-foreground">Privacy Policy</a>
        <span>•</span>
        <a href="/legal/terms" class="hover:text-foreground">Terms</a>
        <span>•</span>
        <span id="copyright"></span>
      </div>
    </div>
    <script>
      var el = document.getElementById('copyright');
      if (el) el.textContent = 'Copyright © ' + new Date().getFullYear() + ' CleanMyBox';
    </script>
  </footer>
}
