package layouts

type SEOProps struct {
  Title       string
  Description string
  Path        string
  Robots      string
}

templ Base(props ...SEOProps) {
  {{
    seo := SEOProps{
      Title:       "CleanMyBox - Email cleaner for Gmail and Outlook",
      Description: "CleanMyBox is an email cleaner for Gmail and Outlook. Remove newsletters, unsubscribe safely, and clean your inbox with one-shot pricing and conservative AI actions.",
      Path:        "/",
      Robots:      "index, follow",
    }
    if len(props) > 0 {
      if props[0].Title != "" {
        seo.Title = props[0].Title
      }
      if props[0].Description != "" {
        seo.Description = props[0].Description
      }
      if props[0].Path != "" {
        seo.Path = props[0].Path
      }
      if props[0].Robots != "" {
        seo.Robots = props[0].Robots
      }
    }
    canonicalURL := "https://cleanmybox.io" + seo.Path
    socialImageURL := "https://cleanmybox.io/assets/img/social-preview.png"
  }}
  <!doctype html>
  <html lang="en">
    <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
      <title>{ seo.Title }</title>
      <meta name="description" content={ seo.Description }/>
      <meta name="author" content="CleanMyBox"/>
      <meta name="application-name" content="CleanMyBox"/>
      <meta name="robots" content={ seo.Robots }/>
      <link rel="canonical" href={ canonicalURL }/>

      <meta property="og:title" content={ seo.Title }/>
      <meta property="og:description" content={ seo.Description }/>
      <meta property="og:type" content="website"/>
      <meta property="og:url" content={ canonicalURL }/>
      <meta property="og:locale" content="en_US"/>
      <meta property="og:site_name" content="CleanMyBox"/>
      <meta property="og:image" content={ socialImageURL }/>
      <meta property="og:image:width" content="1200"/>
      <meta property="og:image:height" content="630"/>
      <meta property="og:image:alt" content="CleanMyBox - Email cleaner for Gmail and Outlook"/>

      <meta name="twitter:card" content="summary_large_image"/>
      <meta name="twitter:title" content={ seo.Title }/>
      <meta name="twitter:description" content={ seo.Description }/>
      <meta name="twitter:image" content={ socialImageURL }/>
      <meta name="twitter:image:alt" content="CleanMyBox - Email cleaner for Gmail and Outlook"/>
      <meta name="theme-color" content="#000000"/>
      <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg"/>
      <link rel="alternate icon" href="/assets/img/favicon.ico"/>

      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": "CleanMyBox",
          "url": "https://cleanmybox.io",
          "description": "Email cleaner for Gmail and Outlook with newsletter detection, safe unsubscribe, and AI actions.",
          "inLanguage": "en"
        }
      </script>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": "CleanMyBox",
          "url": "https://cleanmybox.io",
          "logo": "https://cleanmybox.io/assets/img/social-preview.png"
        }
      </script>
      if seo.Path == "/" {
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "CleanMyBox",
            "applicationCategory": "BusinessApplication",
            "applicationSubCategory": "Email Cleanup Software",
            "operatingSystem": "Web",
            "url": "https://cleanmybox.io",
            "description": "CleanMyBox helps people clean Gmail and Outlook inboxes with newsletter detection, unsubscribe automation, and conservative AI actions.",
            "offers": [
              {
                "@type": "Offer",
                "name": "Clean",
                "price": "5",
                "priceCurrency": "USD"
              },
              {
                "@type": "Offer",
                "name": "CleanPlus",
                "price": "11",
                "priceCurrency": "USD"
              }
            ]
          }
        </script>
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Which mailbox providers does CleanMyBox support?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "CleanMyBox currently supports Gmail and Outlook mailboxes through secure OAuth login."
                }
              },
              {
                "@type": "Question",
                "name": "Do you keep my mailbox data?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No long-term retention. Cleanup jobs keep short-lived operational state only."
                }
              },
              {
                "@type": "Question",
                "name": "How does Clean work?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Clean detects newsletters using email headers like List-Unsubscribe and List-Id, then marks messages as read, moves them to trash, and attempts safe unsubscribe actions."
                }
              },
              {
                "@type": "Question",
                "name": "How does CleanPlus use AI?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "CleanPlus returns an action for each analyzed email: delete, archive, move to spam, or keep. If the model is unsure, the email is kept."
                }
              },
              {
                "@type": "Question",
                "name": "Is this a subscription?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. Pricing is one-shot per cleanup run. You only pay when you launch a run."
                }
              },
              {
                "@type": "Question",
                "name": "Can I get a refund after payment?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Because cleanup starts immediately and infrastructure resources are consumed in real time, payments are final and non-refundable once a run has started, except where required by law."
                }
              },
              {
                "@type": "Question",
                "name": "Do I need to keep this page open during cleanup?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. Cleanup continues on our side even if you close the page, and you can return to check progress anytime."
                }
              }
            ]
          }
        </script>
      }

      <link rel="stylesheet" href="/assets/css/output.css"/>
      <script src="https://unpkg.com/htmx.org@1.9.12"></script>
      <script>
        (function() {
          try {
            var stored = localStorage.getItem('theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (stored === 'dark' || (!stored && prefersDark)) {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
          } catch (_) {}
        })();
      </script>
      <style>
        :root { color-scheme: light; }
        :root.dark { color-scheme: dark; }
      </style>
    </head>
    <body class="min-h-screen bg-background text-foreground">
      { children... }
      <script>
        (function() {
          function apply(next) {
            if (next === 'dark') {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
            try { localStorage.setItem('theme', next); } catch (_) {}
          }
          document.querySelectorAll('[data-theme-switcher]').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var isDark = document.documentElement.classList.contains('dark');
              apply(isDark ? 'light' : 'dark');
            });
          });
        })();
      </script>
    </body>
  </html>
}
